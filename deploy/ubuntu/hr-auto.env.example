# HR Auto server settings. install.sh copies this to /etc/hr-auto/hr-auto.env
# once and only adds missing keys later; your edits are never overwritten.
# After editing run:  sudo systemctl restart hr-auto

PORT=4173
HR_AUTO_TIMEZONE=Asia/Bangkok
HR_AUTO_LOCALE=th-TH

# Team login. Set by install.sh (it asks for the password and stores only
# this scrypt hash). Change it later with:
#   sudo HR_AUTO_RESET_PASSWORD=1 bash deploy/ubuntu/install.sh
# HR_AUTO_PASSWORD_HASH=scrypt:...

# Pause opening new tabs when available RAM drops below this many MB or this
# fraction of total RAM. install.sh lowers it to 350 on servers under 3 GB.
HR_AUTO_MIN_FREE_MEMORY_MB=600
HR_AUTO_MIN_FREE_MEMORY_RATIO=0.10

# A VPS is usually slower than a desktop at loading Facebook.
HR_AUTO_FACEBOOK_LOAD_TIMEOUT_MS=60000

# Chromium runs headed inside the virtual display (Xvfb :99, 1280x800).
# Headless is possible (HR_AUTO_HEADLESS=true) but Facebook treats headless
# browsers with more suspicion and you cannot log in or clear a checkpoint.
# These flags trim CPU and memory: no GPU emulation, no video autoplay, no
# extensions/updaters. install.sh adds --renderer-process-limit on small RAM.
HR_AUTO_BROWSER_ARGS=--window-size=1280,800 --disable-gpu --autoplay-policy=user-gesture-required --mute-audio --disable-extensions --disable-component-update --disable-features=Translate,MediaRouter,OptimizationHints

# Link for the "ดูหน้าจอ Browser" button; install.sh sets it for the chosen
# access mode. {host} becomes the host name used to open HR Auto.
# HR_AUTO_REMOTE_VIEW_URL=/vnc/vnc.html?autoconnect=1&resize=scale&path=vnc/websockify

# Delete system screenshots older than this many days (hand-uploaded
# evidence is never deleted), and delete the oldest first whenever free disk
# space drops below HR_AUTO_MIN_FREE_DISK_MB. 0 turns either off.
HR_AUTO_EVIDENCE_RETENTION_DAYS=60
HR_AUTO_MIN_FREE_DISK_MB=2048

# Random delay before each auto-confirmed post (milliseconds). Posts happen
# one at a time, with at least MIN..2xMIN between two posts.
HR_AUTO_AUTO_CONFIRM_DELAY_MIN_MS=8000
HR_AUTO_AUTO_CONFIRM_DELAY_MAX_MS=150000
