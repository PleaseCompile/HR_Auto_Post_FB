# HR Auto server settings. install.sh copies this to /etc/hr-auto/hr-auto.env
# once; later installs never overwrite your edits. After editing run:
#   sudo systemctl restart hr-auto

PORT=4173
HR_AUTO_TIMEZONE=Asia/Bangkok
HR_AUTO_LOCALE=th-TH

# Pause opening new tabs when available RAM drops below this many MB or this
# fraction of total RAM. The desktop default (4096 MB) would pause forever on a
# 2-4 GB VPS, so servers use a much lower floor.
HR_AUTO_MIN_FREE_MEMORY_MB=600
HR_AUTO_MIN_FREE_MEMORY_RATIO=0.10

# A VPS is usually slower than a desktop at loading Facebook.
HR_AUTO_FACEBOOK_LOAD_TIMEOUT_MS=60000

# Chromium runs headed inside the virtual display (Xvfb :99, 1366x900).
# Headless is possible (HR_AUTO_HEADLESS=true) but Facebook treats headless
# browsers with more suspicion and you cannot log in or clear a checkpoint.
HR_AUTO_BROWSER_ARGS=--window-size=1366,900

# Link for the "ดูหน้าจอ Browser" button. {host} becomes the host name you used
# to open HR Auto. Default without this line: http://{host}:6080/vnc.html...
# With Tailscale serve on port 8443 use:
# HR_AUTO_REMOTE_VIEW_URL=https://{host}:8443/vnc.html?autoconnect=1&resize=scale

# A group that fails before the system presses Post (page did not load,
# composer not found, auto-post error) goes to the back of the queue and is
# retried this many times before being marked failed. 0 disables retries.
HR_AUTO_MAX_AUTO_REQUEUES=1

# Random delay before each auto-confirmed post (milliseconds). Posts happen
# one at a time, with at least MIN..2xMIN between two posts.
HR_AUTO_AUTO_CONFIRM_DELAY_MIN_MS=8000
HR_AUTO_AUTO_CONFIRM_DELAY_MAX_MS=150000
