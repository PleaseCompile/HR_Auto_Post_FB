[Unit]
Description=HR Auto virtual display (Xvfb :99)
After=network.target

[Service]
User=hrauto
# 1280x800: big enough for Facebook's post composer, small enough to keep
# the framebuffer and the VNC stream to several viewers light.
ExecStart=/usr/bin/Xvfb :99 -screen 0 1280x800x24 -nolisten tcp
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
