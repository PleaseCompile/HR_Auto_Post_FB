[Unit]
Description=HR Auto noVNC (browser view of the display, localhost only)
Requires=hr-auto-vnc.service
After=hr-auto-vnc.service

[Service]
User=hrauto
ExecStart=/usr/bin/websockify --web=/usr/share/novnc 127.0.0.1:6080 127.0.0.1:5900
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
