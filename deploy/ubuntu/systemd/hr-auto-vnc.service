[Unit]
Description=HR Auto VNC view of the virtual display (localhost only)
Requires=hr-auto-display.service
After=hr-auto-display.service

[Service]
User=hrauto
ExecStartPre=/bin/sleep 1
# -localhost: never reachable from the network; noVNC/SSH/Tailscale reach it locally.
ExecStart=/usr/bin/x11vnc -display :99 -rfbauth /etc/hr-auto/vnc.pass -localhost -rfbport 5900 -forever -shared -noxdamage -quiet
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
