[Unit]
Description=HR Auto VNC view of the virtual display (localhost only)
Requires=hr-auto-display.service
After=hr-auto-display.service

[Service]
User=hrauto
EnvironmentFile=-/etc/hr-auto/vnc.env
ExecStartPre=/bin/sleep 1
# 127.0.0.1 only: noVNC/Nginx/SSH/Tailscale reach it locally.
ExecStart=/bin/bash /opt/hr-auto/deploy/ubuntu/vnc-server.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
