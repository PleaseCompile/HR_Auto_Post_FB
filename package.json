{
  "name": "hr-auto",
  "version": "0.1.0",
  "private": true,
  "description": "Local assisted Facebook group posting workspace for HR teams.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test:smoke": "node tests/facebook-composer.mjs && node tests/hybrid-run.mjs && node tests/run-deletion.mjs && node tests/group-scan-extraction.mjs && node tests/api-smoke.mjs && node tests/ui-smoke.mjs && node tests/button-audit.mjs",
    "reset:queue-evidence": "node scripts/reset-queue-evidence.mjs",
    "install-browser": "playwright install chromium"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "csv-parse": "^6.1.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "playwright": "^1.54.2",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}
